# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (any depth — the nested IntelliConflict-Map app has its own)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
.coverage
.coverage.*

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# generated caches (never commit build output)
/.contentlayer/
/.cache/

# python
__pycache__/
.pytest_cache/
*.pyc

# logs
*.log

# generated reports (program output, not source)
/backend/support_resistance/reports/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code
.agents/
.claude/
skills-lock.json
/events.json
