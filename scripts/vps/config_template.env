# IntelliTrade VPS Scanner Configuration
# Copy this file to C:\IntelliTrade\config\.env and fill in all values.
# Never commit the real .env to git.

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── MT5 Connection ────────────────────────────────────────────────────────────
# Leave blank if MT5 terminal is already logged in manually.
# Required if running tasks as SYSTEM or without a logged-in user.
MT5_SERVER=MetaQuotes-Demo
MT5_LOGIN=
MT5_PASSWORD=

# ── Feed Configuration ────────────────────────────────────────────────────────
# Must match feed_name in broker_feeds Supabase table.
# Switch to 'switchmarkets_mt5' later when migrating.
ACTIVE_FEED_NAME=metaquotes_demo

# ── Environment ───────────────────────────────────────────────────────────────
SCANNER_ENV=production

# ── CSM Public Reviews ─────────────────────────────────────────────────────────
# Shadow-mode gate for the automated "What Happened Next?" review pipeline.
# Absent/false = shadow: stages 1-4 + 6 run, publication (stage 5) is skipped,
# all public review pages 404, and the sitemap stays silent. Flip to true ONLY
# after the shadow sign-off (see OWNER_TODO.md). Server-side only; never expose
# behind NEXT_PUBLIC_. The pages read the same flag from the Vercel environment.
CSM_PUBLIC_REVIEWS_ENABLED=false

# ── Alerts ───────────────────────────────────────────────────────────────────
# Discord: create a webhook in Server Settings → Integrations → Webhooks
DISCORD_WEBHOOK_URL=

# Telegram: create a bot via @BotFather, get chat_id via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
