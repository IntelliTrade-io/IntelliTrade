# ─── Server-side cache config ─────────────────────────────────────────────────
# TTL in seconds for cached GDELT payloads. Default: 900 (15 min).
CACHE_TTL_SECONDS=900

# Request timeout in ms for upstream GDELT API calls. Default: 9000.
GDELT_REQUEST_TIMEOUT_MS=9000

# Optional: GEO 2.0 geographic match precision. Valid range: 1-5. Default: 2.
# GDELT_GEORES=2

# ─── Supabase server-only cache ───────────────────────────────────────────────
# Required for production caching. Never expose the service role key to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── DeepL translation (server-side only) ─────────────────────────────────────
# Headline translation via DeepL API Free. Translations are cached server-side;
# only non-English headlines are translated; no client-side calls are made.
#
# How to get a key:
#   1. Sign up at https://www.deepl.com/pro#developer (Free tier available)
#   2. API Free keys end in ":fx" — the SDK routes to api-free.deepl.com automatically
#
# IMPORTANT: Never set this as NEXT_PUBLIC_* — must remain server-only.
DEEPL_API_KEY=

# Optional: override the target language for translated headlines. Default: EN-US
# DEEPL_TARGET_LANG=EN-US

# Optional: set to "false" to disable all translation (useful for local dev). Default: enabled.
# DEEPL_ENABLE_TRANSLATION=true
